# Terraform variable values for the dev environment.
# Copy this file to terraform.tfvars and adjust values for your own project.

# GCP project to deploy into.
# project_id = "my-project-1508887546225"

# Primary region for Cloud Run, GCS, etc.
# region = "us-central1"

# GCS bucket location. Use a multi-region or dual-region value if desired.
# gcs_location = "US-CENTRAL1"

# BigQuery dataset location.
# bigquery_location = "US"

# Cloud Scheduler region (must support App Engine in the chosen location).
# scheduler_region = "us-central1"

# Container image deployed to Cloud Run and Cloud Run Jobs.
# Typically set by CI/CD; only override here for local/manual testing.
# api_image = "us-central1-docker.pkg.dev/my-project-1508887546225/mt-oil-api/mt-oil-api:latest"
