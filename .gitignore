# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb-filter/
.vscode-jupyter/

# Data files generated by pull_data.py (IMPORTANT: Do NOT commit downloaded data)
# These are typically too large and change frequently
*.zip
*.tab
*.csv
*.xlsx # In case you generate any Excel outputs

# Operating System files
.DS_Store # macOS specific
.Trash-* # macOS specific
Thumbs.db # Windows specific

# IDE specific files (if you use PyCharm, etc.)
.idea/
.vscode/

# Logs and temporary files
*.log
*.tmp
*.temp

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gcp-*.json
credentials.json
google-application-credentials.json

# Terraform / IaC
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
crash.log
override.tf
*_override.tf
.terraformrc
terraform.rc

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log

# Frontend build artifacts (tracked by CI, not source)
frontend/dist/
frontend/dist-ssr/

# Coverage reports
htmlcov/
.coverage
.coverage.*

# Model artifacts generated at runtime
*.joblib
*.pkl
*.h5

# macOS
.DS_Store
